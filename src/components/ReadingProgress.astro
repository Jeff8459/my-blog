<div class="reading-progress" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
<script>
	const progress = document.querySelector<HTMLElement>('.reading-progress');
	const bar = progress?.querySelector<HTMLElement>('span');
	const article = document.querySelector<HTMLElement>('.prose');
	let ticking = false;
	const update = () => {
		if (progress && bar && article) {
			const start = article.getBoundingClientRect().top + scrollY - innerHeight * .25;
			const distance = Math.max(1, article.offsetHeight - innerHeight * .5);
			const value = Math.min(100, Math.max(0, ((scrollY - start) / distance) * 100));
			bar.style.transform = `scaleX(${value / 100})`;
			progress.setAttribute('aria-valuenow', String(Math.round(value)));
		}
		ticking = false;
	};
	addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
	addEventListener('resize', update);
	update();
</script>
<style>
	.reading-progress { position: fixed; z-index: 100; top: 0; right: 0; left: 0; height: 2px; pointer-events: none; }
	.reading-progress span { display: block; width: 100%; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
</style>
