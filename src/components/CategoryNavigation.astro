---
import { categories } from '../config/taxonomy';
import { getPublishedPosts } from '../lib/content';
const posts = await getPublishedPosts();
const path = Astro.url.pathname;
---
<nav class="category-pills" aria-label="按分类筛选">
	<a href="/blog/" aria-current={path === '/blog/' || path.startsWith('/blog/page/') ? 'page' : undefined}><span>全部</span><small>{posts.length}</small></a>
	{categories.map((category) => {
		const count = posts.filter((post) => post.data.category === category.slug).length;
		return <a href={`/categories/${category.slug}/`} aria-current={path.startsWith(`/categories/${category.slug}/`) ? 'page' : undefined}><span>{category.name}</span><small>{count}</small></a>;
	})}
</nav>
<style>
	.category-pills { display: flex; flex-wrap: wrap; gap: 4px; padding: 9px 0; border-bottom: 1px solid var(--line); }
	a { display: inline-flex; align-items: center; gap: 5px; min-height: 26px; padding: 0 8px; border-radius: 4px; color: var(--muted); font-size: 11px; text-decoration: none; }
	a:hover { background: var(--hover); color: var(--text); }
	a[aria-current="page"] { background: var(--active); color: var(--accent); }
	small { color: var(--faint); font-family: var(--font-mono); font-size: 9px; }
	a[aria-current="page"] small { color: var(--accent); }
</style>
