---
interface Props { page: number; pageCount: number; base?: string; }
const { page, pageCount, base = '/blog' } = Astro.props;
const href = (number: number) => number === 1 ? `${base}/` : `${base}/page/${number}/`;
---
{pageCount > 1 && <nav class="pagination" aria-label="文章分页">
	{page > 1 ? <a href={href(page - 1)} rel="prev">← 上一页</a> : <span />}
	<span class="page-state">{page} / {pageCount}</span>
	{page < pageCount ? <a href={href(page + 1)} rel="next">下一页 →</a> : <span />}
</nav>}
<style>
	.pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-top: 18px; color: var(--muted); font-size: 11.5px; }
	.pagination a { color: var(--muted); text-decoration: none; }
	.pagination a:last-child { text-align: right; }
	.pagination a:hover { color: var(--accent); }
	.page-state { color: var(--faint); font-family: var(--font-mono); font-size: 10px; }
</style>
