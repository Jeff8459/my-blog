---
import { site } from '../config/site';
---
<footer class="site-footer" data-pagefind-ignore>
	<p>© {new Date().getFullYear()} {site.author.name}</p>
	<nav aria-label="页脚导航"><a href="/rss.xml">RSS</a><a href="/about/">关于</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a></nav>
	<a class="top-link" href="#main-content">回到顶部 ↑</a>
</footer>
<style>
	.site-footer { display: flex; align-items: center; gap: 18px; margin-top: 48px; padding: 16px 0 24px; border-top: 1px solid var(--line); color: var(--faint); font-family: var(--font-mono); font-size: 10px; }
	.site-footer nav { display: flex; gap: 12px; margin-left: auto; }
	.site-footer a { color: var(--muted); text-decoration: none; }
	.site-footer a:hover { color: var(--accent); }
	.top-link { flex: none; }
	@media (max-width: 420px) { .site-footer { gap: 10px; } .site-footer p { display: none; } .site-footer nav { margin-left: 0; } .top-link { margin-left: auto; } }
</style>
