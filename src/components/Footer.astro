---
import { site } from '../config/site';
---
<footer class="site-footer" data-pagefind-ignore>
	<div class="shell footer-grid">
		<div class="footer-brand"><span>{site.name}</span><small>{site.englishName}</small><p>{site.tagline}</p></div>
		<nav class="footer-links" aria-label="页脚导航">
			<a href="/about/">关于本站</a><a href="/rss.xml">RSS 订阅</a>
			<a href={site.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only">（新窗口打开）</span></a>
		</nav>
		<a class="back-to-top" href="#main-content">回到顶部 <span aria-hidden="true">↑</span></a>
	</div>
	<div class="shell footer-bottom"><span>© {new Date().getFullYear()} {site.author.name}</span><span>文字与思考，缓慢积累。</span></div>
</footer>
<style>
	.site-footer { margin-top: var(--space-24); border-top: 1px solid var(--line); }
	.footer-grid { display: grid; grid-template-columns: 1fr auto auto; align-items: start; gap: 3rem; padding-top: 3.5rem; padding-bottom: 3.5rem; }
	.footer-brand { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: .7rem; }
	.footer-brand > span { font-size: 1.1rem; font-weight: 650; letter-spacing: .08em; }
	.footer-brand small { color: var(--muted); font-family: var(--font-serif); font-size: .65rem; letter-spacing: .18em; }
	.footer-brand p { grid-column: 1 / -1; margin: .7rem 0 0; color: var(--muted); font-size: .84rem; }
	.footer-links { display: flex; gap: 1.6rem; font-size: .82rem; }
	.footer-links a, .back-to-top { color: var(--muted); text-decoration: none; }
	.footer-links a:hover, .back-to-top:hover { color: var(--accent); }
	.back-to-top { font-size: .82rem; }
	.back-to-top span { margin-left: .4rem; }
	.footer-bottom { display: flex; justify-content: space-between; padding-top: 1.25rem; padding-bottom: 1.5rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .72rem; letter-spacing: .03em; }
	@media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr auto; gap: 2rem; padding-top: 2.5rem; padding-bottom: 2.5rem; } .footer-links { grid-column: 1 / -1; grid-row: 2; flex-wrap: wrap; gap: 1.2rem; } .back-to-top { grid-column: 2; grid-row: 1; } .footer-bottom { gap: 1rem; } .footer-bottom span:last-child { display: none; } }
</style>
