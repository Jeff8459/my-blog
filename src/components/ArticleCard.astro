---
import { Image } from 'astro:assets';
import type { BlogPost } from '../lib/content';
import { getCategory } from '../config/taxonomy';
import { getReadingTime } from '../lib/reading-time';
import FormattedDate from './FormattedDate.astro';

interface Props { post: BlogPost; eager?: boolean; }
const { post, eager = false } = Astro.props;
const cover = post.data.cover ?? post.data.heroImage;
const category = getCategory(post.data.category);
---
<article class="article-card">
	<a class="card-image" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
		{cover ? <Image src={cover} alt="" widths={[480, 720, 960]} sizes="(max-width: 720px) 100vw, 33vw" width={720} height={480} loading={eager ? 'eager' : 'lazy'} /> : <span class="image-fallback">{category.name}</span>}
	</a>
	<div class="card-content">
		<div class="card-kicker"><a href={`/categories/${category.slug}/`}>{category.name}</a>{post.data.demo && <span class="demo-label">示例</span>}</div>
		<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
		<p class="card-description">{post.data.description}</p>
		<div class="card-meta"><FormattedDate date={post.data.pubDate} /><span aria-hidden="true">·</span><span>{getReadingTime(post.body)} 分钟阅读</span></div>
	</div>
</article>
<style>
	.article-card { min-width: 0; }
	.card-image { display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--image-bg); }
	.card-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.78); transition: transform .45s ease, filter .3s ease; }
	.article-card:hover .card-image img { transform: scale(1.018); filter: saturate(.95); }
	.image-fallback { display: grid; place-items: center; height: 100%; color: var(--muted); font-family: var(--font-serif); font-size: .75rem; letter-spacing: .15em; }
	.card-content { padding-top: 1.25rem; }
	.card-kicker { display: flex; align-items: center; gap: .65rem; margin-bottom: .7rem; }
	.card-kicker > a { color: var(--accent); font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-decoration: none; }
	h3 { font-size: clamp(1.18rem, 1.8vw, 1.45rem); line-height: 1.5; }
	h3 a { color: var(--text); text-decoration: none; }
	h3 a:hover { color: var(--accent); }
	.card-description { display: -webkit-box; margin-top: .7rem; overflow: hidden; color: var(--muted); font-size: .87rem; line-height: 1.85; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.card-meta { display: flex; gap: .5rem; margin-top: 1rem; color: var(--muted); font-family: var(--font-serif); font-size: .7rem; letter-spacing: .02em; }
</style>
