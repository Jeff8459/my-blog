---
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; variant: 'mobile' | 'desktop'; }
const { headings, variant } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
{items.length > 0 && variant === 'mobile' && <details class="mobile-toc" data-toc>
	<summary>本页目录<span>{items.length} 节</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m5 6 3 3 3-3"/></svg></summary>
	<nav aria-label="移动端文章目录">{items.map((item) => <a class:list={[`depth-${item.depth}`]} href={`#${item.slug}`}>{item.text}</a>)}</nav>
</details>}
{items.length > 0 && variant === 'desktop' && <section class="desktop-toc" data-toc>
	<p class="aside-label">ON THIS PAGE</p>
	<nav aria-label="文章目录">{items.map((item) => <a class:list={[`depth-${item.depth}`]} href={`#${item.slug}`}>{item.text}</a>)}</nav>
</section>}
<script>
	const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
	const headings = tocLinks.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter(Boolean) as HTMLElement[];
	if (headings.length) {
		const setActive = (id: string) => tocLinks.forEach((link) => {
			if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
		});
		const observer = new IntersectionObserver((entries) => {
			const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
			if (visible[0]) setActive(visible[0].target.id);
		}, { rootMargin: '-12% 0px -72% 0px', threshold: 0 });
		headings.forEach((heading) => observer.observe(heading));
	}
</script>
<style>
	.desktop-toc > p { margin-bottom: 7px; }
	nav { display: grid; gap: 1px; }
	a { display: block; padding: 3px 0 3px 9px; border-left: 1px solid var(--line); color: var(--muted); font-size: 11.5px; line-height: 1.55; text-decoration: none; }
	a.depth-3 { padding-left: 18px; font-size: 11px; }
	a:hover, a[aria-current="location"] { border-left-color: var(--accent); color: var(--accent); }
	.mobile-toc { margin: 18px 0 0; border-block: 1px solid var(--line); }
	.mobile-toc summary { display: flex; align-items: center; gap: 6px; min-height: 38px; color: var(--text); font-size: 12px; cursor: pointer; list-style: none; }
	.mobile-toc summary::-webkit-details-marker { display: none; }
	.mobile-toc summary span { margin-left: auto; color: var(--faint); font-size: 10px; }
	.mobile-toc summary svg { width: 12px; fill: none; stroke: var(--muted); transition: transform .15s; }
	.mobile-toc:not([open]) summary svg { transform: rotate(-90deg); }
	.mobile-toc nav { padding: 3px 0 9px; }
	@media (min-width: 1025px) { .mobile-toc { display: none; } }
</style>
