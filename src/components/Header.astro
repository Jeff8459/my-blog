---
import { site } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="site-header" data-pagefind-ignore>
	<div class="header-inner">
		<div class="header-brand">
			<button class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="garden-sidebar" aria-label="打开知识导航" data-menu-toggle>
				<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"/></svg>
			</button>
			<a class="brand" href="/" aria-label={`${site.name}首页`}>
				<span class="brand-glyph" aria-hidden="true">N</span>
				<span class="brand-name">{site.name}</span>
				<span class="brand-divider" aria-hidden="true">/</span>
				<span class="brand-en">{site.englishName}</span>
			</a>
		</div>
		<div class="header-context"><span>PERSONAL KNOWLEDGE GARDEN</span></div>
		<div class="header-actions">
			<button class="search-trigger" type="button" data-search-open aria-label="打开全文搜索">
				<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5"/><path d="m13 13 4 4"/></svg>
				<span>搜索</span><kbd>⌘K</kbd>
			</button>
			<a class="icon-button github-link" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="访问 GitHub 仓库">
				<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.2a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.65-.89-3.65-3.96 0-.88.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.52.56.83 1.27.83 2.15 0 3.08-1.88 3.76-3.66 3.96.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 10 2.2Z"/></svg>
			</a>
			<ThemeToggle />
		</div>
	</div>
</header>
<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
	const backdrop = document.querySelector<HTMLElement>('.sidebar-backdrop');
	const openSidebar = (open: boolean) => {
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? '关闭知识导航' : '打开知识导航');
		if (open) sidebar?.setAttribute('data-open', ''); else sidebar?.removeAttribute('data-open');
		if (backdrop) backdrop.hidden = !open;
	};
	toggle?.addEventListener('click', () => openSidebar(toggle.getAttribute('aria-expanded') !== 'true'));
	document.querySelectorAll('[data-sidebar-close]').forEach((button) => button.addEventListener('click', () => { openSidebar(false); toggle?.focus(); }));
	sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => openSidebar(false)));
	document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { openSidebar(false); toggle.focus(); } });
	matchMedia('(min-width: 1025px)').addEventListener('change', (event) => { if (event.matches) openSidebar(false); });
</script>
<style>
	.site-header { position: sticky; z-index: 60; top: 0; height: var(--header-height); border-bottom: 1px solid var(--line); background: var(--bg); }
	.header-inner { display: grid; grid-template-columns: calc(var(--sidebar-width) - 20px) minmax(0, 1fr) auto; align-items: center; height: 100%; padding: 0 12px; }
	.header-brand { display: flex; align-items: center; gap: 7px; min-width: 0; }
	.brand { display: flex; align-items: center; gap: 8px; min-width: 0; color: var(--text); text-decoration: none; }
	.brand-glyph { display: inline-flex; flex: none; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 4px; background: var(--text); color: var(--bg); font-family: var(--font-mono); font-size: 10px; font-weight: 700; }
	.brand-name { overflow: hidden; font-size: 13px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
	.brand-divider { color: var(--line-strong); font-family: var(--font-mono); font-size: 10px; }
	.brand-en { flex: none; color: var(--faint); font-family: var(--font-mono); font-size: 9px; letter-spacing: .08em; }
	.header-context { padding-left: 20px; color: var(--faint); font-family: var(--font-mono); font-size: 9px; letter-spacing: .11em; }
	.header-actions { display: flex; align-items: center; gap: 3px; }
	.header-actions svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
	.github-link svg { fill: currentColor; stroke: none; }
	.search-trigger { display: flex; align-items: center; gap: 7px; height: 30px; padding: 0 8px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--muted); font-size: 11.5px; cursor: pointer; }
	.search-trigger:hover { border-color: var(--line-strong); color: var(--text); }
	.search-trigger kbd { padding: 0 3px; border: 1px solid var(--line); border-radius: 2px; color: var(--faint); font-family: var(--font-mono); font-size: 8.5px; }
	.menu-toggle { display: none; }
	@media (max-width: 1024px) {
		.header-inner { grid-template-columns: 1fr auto; padding-inline: 14px; }
		.menu-toggle { display: inline-flex; }
		.header-context { display: none; }
		.brand-glyph { display: none; }
	}
	@media (max-width: 640px) {
		.brand-divider, .brand-en, .search-trigger > span, .search-trigger kbd, .github-link { display: none; }
		.search-trigger { width: 32px; padding: 0; justify-content: center; border: 0; background: transparent; }
		.header-actions { gap: 0; }
	}
</style>
