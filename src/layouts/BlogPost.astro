---
import type { BlogPost } from '../lib/content';
import { getCategory, getTag } from '../config/taxonomy';
import { getReadingTime } from '../lib/reading-time';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ArticleActions from '../components/ArticleActions.astro';
import PostList from '../components/PostList.astro';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
	post: BlogPost;
	headings: Heading[];
	newer?: BlogPost;
	older?: BlogPost;
	related: BlogPost[];
	backlinks: BlogPost[];
}
const { post, headings, newer, older, related, backlinks } = Astro.props;
const { data } = post;
const cover = data.cover ?? data.heroImage;
const category = getCategory(data.category);
---
<BaseLayout
	title={data.seoTitle ?? data.title}
	description={data.seoDescription ?? data.description}
	image={cover}
	type="article"
	publishedTime={data.pubDate}
	modifiedTime={data.updatedDate}
	pagefind={true}
>
	<ReadingProgress />
	<article class="post">
		<nav class="breadcrumb" aria-label="面包屑">
			<a href="/">首页</a><span aria-hidden="true">/</span>
			<a href={`/categories/${category.slug}/`}>{category.name}</a><span aria-hidden="true">/</span>
			<span aria-current="page">笔记</span>
		</nav>
		<header class="post-header">
			<div class="post-kicker">{data.demo && <span class="demo-label">示例文章</span>}<a href={`/categories/${category.slug}/`}>{category.name}</a></div>
			<h1>{data.title}</h1>
			<p class="post-description">{data.description}</p>
			<div class="post-meta">
				<span>{data.author}</span><span aria-hidden="true">·</span>
				<FormattedDate date={data.pubDate} />
				{data.updatedDate && <><span aria-hidden="true">·</span><span>更新于 <FormattedDate date={data.updatedDate} /></span></>}
				<span aria-hidden="true">·</span><span>{getReadingTime(post.body)} 分钟阅读</span>
			</div>
			{data.tags.length > 0 && <div class="post-tags">{data.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>#{getTag(tag)?.name ?? tag}</a>)}</div>}
		</header>
		<TableOfContents headings={headings} variant="mobile" />
		<div class="article-body"><div class="prose"><slot /></div></div>
		<footer class="post-footer">
			<div class="post-actions-row"><a class="text-link" href={`/categories/${category.slug}/`}>← 返回「{category.name}」</a><ArticleActions title={data.title} /></div>
		</footer>
	</article>
	<nav class="post-navigation" aria-label="相邻文章" data-pagefind-ignore>
		{newer ? <a class="newer" href={`/blog/${newer.id}/`}><span>← 上一篇</span><strong>{newer.data.title}</strong></a> : <span />}
		{older ? <a class="older" href={`/blog/${older.id}/`}><span>下一篇 →</span><strong>{older.data.title}</strong></a> : <span />}
	</nav>
	{related.length > 0 && <section class="related-bottom" aria-labelledby="related-title" data-pagefind-ignore>
		<div class="section-header"><h2 id="related-title">相关笔记</h2><a href="/blog/">全部文章</a></div>
		<PostList posts={related} variant="dense" showReadingTime={false} />
	</section>}

	<div slot="aside" class="article-aside" data-pagefind-ignore>
		<div class="aside-inner">
			<TableOfContents headings={headings} variant="desktop" />
			<section class="aside-block">
				<p class="aside-label">RELATED NOTES</p>
				<h2>相关文章</h2>
				{related.length ? <PostList posts={related.slice(0, 3)} variant="dense" showReadingTime={false} /> : <p class="aside-empty">暂无相关笔记。</p>}
			</section>
			<section class="aside-block">
				<p class="aside-label">BACKLINKS</p>
				<h2>被引用 <span>{backlinks.length}</span></h2>
				{backlinks.length ? <ul class="backlink-list">{backlinks.map((item) => <li><a href={`/blog/${item.id}/`}>{item.data.title}</a><span>{item.data.title}</span></li>)}</ul> : <p class="aside-empty">还没有其他笔记引用本文。</p>}
			</section>
			<section class="aside-block aside-context">
				<p class="aside-label">CONTEXT</p>
				<dl><div><dt>分类</dt><dd><a href={`/categories/${category.slug}/`}>{category.name}</a></dd></div><div><dt>发布</dt><dd><FormattedDate date={data.pubDate} /></dd></div>{data.updatedDate && <div><dt>更新</dt><dd><FormattedDate date={data.updatedDate} /></dd></div>}</dl>
			</section>
		</div>
	</div>
</BaseLayout>
<script>
	document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-wrap';
		pre.parentNode?.insertBefore(wrapper, pre);
		wrapper.appendChild(pre);
		const button = document.createElement('button');
		button.type = 'button'; button.className = 'code-copy'; button.textContent = '复制';
		button.setAttribute('aria-label', '复制代码');
		button.addEventListener('click', async () => {
			try { await navigator.clipboard.writeText(pre.innerText); button.textContent = '已复制'; }
			catch { button.textContent = '失败'; }
			setTimeout(() => { button.textContent = '复制'; }, 1800);
		});
		wrapper.appendChild(button);
	});
	document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
		const wrapper = document.createElement('div'); wrapper.className = 'table-wrapper'; wrapper.tabIndex = 0;
		wrapper.setAttribute('role', 'region'); wrapper.setAttribute('aria-label', '可横向滚动的表格');
		table.parentNode?.insertBefore(wrapper, table); wrapper.appendChild(table);
	});
	document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]').forEach((link) => {
		if (link.origin !== location.origin) { link.target = '_blank'; link.rel = 'noopener noreferrer'; }
	});
</script>
<style>
	.breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding-top: 22px; color: var(--faint); font-size: 10.5px; }
	.breadcrumb a { color: var(--muted); text-decoration: none; }
	.breadcrumb a:hover { color: var(--accent); }
	.post-header { padding: 12px 0 18px; border-bottom: 1px solid var(--line); }
	.post-kicker { display: flex; align-items: center; gap: 7px; margin-bottom: 7px; }
	.post-kicker > a { color: var(--accent); font-size: 10.5px; font-weight: 600; text-decoration: none; }
	h1 { max-width: 720px; font-size: 30px; font-weight: 650; line-height: 1.35; letter-spacing: -.025em; }
	.post-description { max-width: 680px; margin-top: 9px; color: var(--muted); font-size: 13px; line-height: 1.7; }
	.post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 11px; color: var(--faint); font-family: var(--font-mono); font-size: 10px; }
	.post-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
	.article-body { padding-top: 22px; }
	.post-footer { margin-top: 32px; padding-top: 14px; border-top: 1px solid var(--line); }
	.post-actions-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
	.post-navigation { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 28px; }
	.post-navigation a { display: grid; gap: 3px; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius); color: var(--text); text-decoration: none; }
	.post-navigation a:hover { border-color: var(--line-strong); background: var(--hover); }
	.post-navigation a > span { color: var(--faint); font-size: 10px; }
	.post-navigation strong { font-size: 12px; font-weight: 550; line-height: 1.55; }
	.post-navigation .older { text-align: right; }
	.related-bottom { margin-top: 32px; }
	.aside-inner { position: sticky; top: calc(var(--header-height) + 18px); }
	.aside-block { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
	.aside-block h2 { margin: 3px 0 7px; font-size: 12px; font-weight: 600; }
	.aside-block h2 span { display: inline-flex; align-items: center; justify-content: center; min-width: 17px; height: 17px; margin-left: 3px; border-radius: 9px; background: var(--accent-soft); color: var(--accent); font-family: var(--font-mono); font-size: 9px; }
	.aside-empty { color: var(--faint); font-size: 10.5px; line-height: 1.65; }
	.backlink-list { padding: 0; list-style: none; }
	.backlink-list li { margin: 0; }
	.backlink-list a { display: block; padding: 4px 0; color: var(--muted); font-size: 11px; line-height: 1.55; text-decoration: none; }
	.backlink-list a:hover { color: var(--accent); }
	.backlink-list span { display: none; }
	.aside-context dl { display: grid; gap: 4px; margin: 0; }
	.aside-context dl div { display: flex; justify-content: space-between; gap: 8px; font-size: 10.5px; }
	.aside-context dt { color: var(--faint); }
	.aside-context dd { margin: 0; color: var(--muted); text-align: right; }
	.aside-context dd a { color: var(--muted); text-decoration: none; }
	.aside-context dd a:hover { color: var(--accent); }
	@media (max-width: 1024px) { .article-aside { display: none; } }
	@media (max-width: 640px) { .breadcrumb { padding-top: 16px; } h1 { font-size: 25px; } .post-meta { font-size: 9.5px; } .post-actions-row { align-items: flex-start; flex-direction: column; } .post-navigation { grid-template-columns: 1fr; } .post-navigation .older { text-align: left; } .post-navigation span:empty { display: none; } }
</style>
