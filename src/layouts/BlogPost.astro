---
import { Image } from 'astro:assets';
import type { BlogPost } from '../lib/content';
import { getCategory, getTag } from '../config/taxonomy';
import { getReadingTime } from '../lib/reading-time';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ArticleActions from '../components/ArticleActions.astro';
import ArticleCard from '../components/ArticleCard.astro';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
	post: BlogPost;
	headings: Heading[];
	newer?: BlogPost;
	older?: BlogPost;
	related: BlogPost[];
}
const { post, headings, newer, older, related } = Astro.props;
const { data } = post;
const cover = data.cover ?? data.heroImage;
const category = getCategory(data.category);
---
<BaseLayout
	title={data.seoTitle ?? data.title}
	description={data.seoDescription ?? data.description}
	image={cover}
	type="article"
	publishedTime={data.pubDate}
	modifiedTime={data.updatedDate}
	pagefind={true}
>
	<ReadingProgress />
	<article class="post">
		<header class="post-header reading-shell">
			<div class="post-kicker"><a href={`/categories/${category.slug}/`}>{category.name}</a>{data.demo && <span class="demo-label">示例文章</span>}</div>
			<h1>{data.title}</h1>
			<p class="post-description">{data.description}</p>
			<div class="post-meta">
				<span>文 / {data.author}</span><span aria-hidden="true">·</span><FormattedDate date={data.pubDate} />
				<span aria-hidden="true">·</span><span>{getReadingTime(post.body)} 分钟阅读</span>
			</div>
			{data.updatedDate && <p class="updated">更新于 <FormattedDate date={data.updatedDate} /></p>}
		</header>
		{cover && <figure class="post-cover shell"><Image src={cover} alt={data.coverAlt ?? ''} width={1440} height={810} widths={[720, 1080, 1440]} sizes="(max-width: 1200px) 100vw, 1200px" loading="eager" fetchpriority="high" /></figure>}
		<div class="article-layout shell">
			<div>
				<TableOfContents headings={headings} variant="mobile" />
				<div class="prose"><slot /></div>
				<footer class="post-footer">
					{data.tags.length > 0 && <div class="post-tags"><span>标签</span>{data.tags.map((tag) => <a href={`/tags/${tag}/`}>#{getTag(tag)?.name ?? tag}</a>)}</div>}
					<div class="post-actions-row"><a class="text-link" href="/blog/">返回文章归档</a><ArticleActions title={data.title} /></div>
				</footer>
			</div>
			<TableOfContents headings={headings} variant="desktop" />
		</div>
	</article>
	<nav class="post-navigation shell" aria-label="相邻文章" data-pagefind-ignore>
		{newer ? <a class="newer" href={`/blog/${newer.id}/`}><span>← 上一篇</span><strong>{newer.data.title}</strong></a> : <span />}
		{older ? <a class="older" href={`/blog/${older.id}/`}><span>下一篇 →</span><strong>{older.data.title}</strong></a> : <span />}
	</nav>
	{related.length > 0 && <section class="related shell" data-pagefind-ignore>
		<div class="section-heading"><div><p class="eyebrow">READ NEXT</p><h2>继续阅读</h2></div></div>
		<div class="related-grid">{related.map((item) => <ArticleCard post={item} />)}</div>
	</section>}
</BaseLayout>
<script>
	document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-wrap';
		pre.parentNode?.insertBefore(wrapper, pre);
		wrapper.appendChild(pre);
		const button = document.createElement('button');
		button.type = 'button'; button.className = 'code-copy'; button.textContent = '复制代码';
		button.setAttribute('aria-label', '复制代码');
		button.addEventListener('click', async () => {
			try { await navigator.clipboard.writeText(pre.innerText); button.textContent = '已复制'; }
			catch { button.textContent = '复制失败'; }
			setTimeout(() => { button.textContent = '复制代码'; }, 2000);
		});
		wrapper.appendChild(button);
	});
	document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
		const wrapper = document.createElement('div'); wrapper.className = 'table-wrapper'; wrapper.tabIndex = 0;
		wrapper.setAttribute('role', 'region'); wrapper.setAttribute('aria-label', '可横向滚动的表格');
		table.parentNode?.insertBefore(wrapper, table); wrapper.appendChild(table);
	});
	document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]').forEach((link) => {
		if (link.origin !== location.origin) { link.target = '_blank'; link.rel = 'noopener noreferrer'; }
	});
</script>
<style>
	.post-header { padding-top: clamp(3.5rem, 7vw, 6.5rem); padding-bottom: clamp(2.5rem, 5vw, 4rem); text-align: center; }
	.post-kicker { display: flex; justify-content: center; align-items: center; gap: .7rem; margin-bottom: 1.3rem; }
	.post-kicker > a { color: var(--accent); font-size: .73rem; font-weight: 600; letter-spacing: .1em; text-decoration: none; }
	h1 { font-size: clamp(2.2rem, 5vw, 4.2rem); font-weight: 600; line-height: 1.3; letter-spacing: -.05em; }
	.post-description { max-width: 620px; margin: 1.4rem auto 0; color: var(--muted); font-size: .98rem; line-height: 1.9; }
	.post-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem; margin-top: 1.8rem; color: var(--muted); font-family: var(--font-serif); font-size: .72rem; }
	.updated { margin-top: .5rem; color: var(--muted); font-size: .68rem; }
	.post-cover { margin-bottom: clamp(3rem, 6vw, 5rem); }
	.post-cover img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--image-bg); filter: saturate(.85); }
	.article-layout { display: grid; grid-template-columns: minmax(0, var(--reading)) 180px; justify-content: center; gap: clamp(2rem, 4vw, 4rem); }
	.post-footer { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
	.post-tags { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; font-size: .74rem; }
	.post-tags > span { margin-right: .3rem; color: var(--muted); }
	.post-tags a { color: var(--muted); text-decoration: none; }
	.post-tags a:hover { color: var(--accent); }
	.post-actions-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 2rem; }
	.post-navigation { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: var(--space-24); }
	.post-navigation a { display: grid; gap: .65rem; padding: 1.5rem 0; border-block: 1px solid var(--line); color: var(--text); text-decoration: none; }
	.post-navigation a:hover strong { color: var(--accent); }
	.post-navigation a > span { color: var(--muted); font-size: .7rem; }
	.post-navigation strong { font-size: .95rem; font-weight: 550; }
	.post-navigation .older { text-align: right; }
	.related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
	@media (max-width: 1023px) { .article-layout { grid-template-columns: minmax(0, var(--reading)); } }
	@media (max-width: 720px) { .post-header { text-align: left; } .post-kicker, .post-meta { justify-content: flex-start; } h1 { font-size: clamp(2rem, 10vw, 3rem); } .post-description { margin-left: 0; font-size: .92rem; } .post-cover { padding-inline: 0; margin-bottom: 1rem; } .post-cover img { aspect-ratio: 4 / 3; } .post-actions-row { align-items: flex-start; flex-direction: column; } .post-navigation { gap: 1rem; } .post-navigation strong { font-size: .82rem; } .related-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
