---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getAdjacentPosts, getPublishedPosts, getRelatedPosts } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			...getAdjacentPosts(post, posts),
			related: getRelatedPosts(post, posts),
		},
	}));
}
const { post, newer, older, related } = Astro.props;
const { Content, headings } = await render(post);
---
<BlogPost post={post} headings={headings} newer={newer} older={older} related={related}>
	<Content />
</BlogPost>
