---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import CategoryNavigation from '../../components/CategoryNavigation.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedPosts, paginate } from '../../lib/content';
import { site } from '../../config/site';
const posts = await getPublishedPosts();
const page = paginate(posts, 1, site.postsPerPage);
---
<BaseLayout title="文章归档" description={`全部文章，共 ${posts.length} 篇。按时间倒序阅读技术、管理、阅读与生活记录。`}>
	<header class="page-hero shell"><div><p class="eyebrow">THE ARCHIVE</p><h1>文章归档</h1></div><div><span class="page-count">{String(posts.length).padStart(2, '0')} ARTICLES</span><p>按时间顺序保存每一次思考。也可以从分类进入，沿着感兴趣的主题继续阅读。</p></div></header>
	<div class="shell archive-controls"><CategoryNavigation /></div>
	<section class="shell archive-list" aria-label="全部文章">
		{page.items.length ? page.items.map((post, index) => <ArticleRow post={post} index={(page.page - 1) * site.postsPerPage + index} />) : <div class="empty-state"><h2>还没有已发布文章</h2><p>新增 Markdown 文章后，这里会自动更新。</p></div>}
		<Pagination page={page.page} pageCount={page.pageCount} />
	</section>
</BaseLayout>
<style>
	.archive-controls { margin-top: 2rem; }
	.archive-list { padding-top: 1.5rem; }
</style>
