---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import CategoryNavigation from '../../components/CategoryNavigation.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedPosts, paginate } from '../../lib/content';
import { site } from '../../config/site';
const posts = await getPublishedPosts();
const page = paginate(posts, 1, site.postsPerPage);
---
<BaseLayout title="全部文章" description={`全部已发布笔记，共 ${posts.length} 篇。按时间倒序浏览。`}>
	<header class="page-header"><p class="eyebrow">NOTES / ALL</p><h1>全部文章</h1><p class="description">按发布时间倒序排列。分类负责长期归档，标签连接跨主题的相关内容。</p><div class="meta-line"><span>{posts.length} 篇已发布</span><span>·</span><span>第 {page.page} / {page.pageCount} 页</span></div></header>
	<CategoryNavigation />
	<section class="archive-list" aria-label="全部文章">
		<PostList posts={page.items} emptyTitle="还没有已发布文章" emptyText="新增 Markdown 后，内容会自动出现在这里。" />
		<Pagination page={page.page} pageCount={page.pageCount} />
	</section>
</BaseLayout>
<style>.archive-list { margin-top: 4px; }</style>
