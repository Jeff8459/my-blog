---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostList from '../../../../components/PostList.astro';
import CategoryNavigation from '../../../../components/CategoryNavigation.astro';
import Pagination from '../../../../components/Pagination.astro';
import { getPublishedPosts, paginate } from '../../../../lib/content';
import { site } from '../../../../config/site';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const pageCount = Math.ceil(posts.length / site.postsPerPage);
	return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => ({ params: { page: String(index + 2) } }));
}
const posts = await getPublishedPosts();
const pageNumber = Number(Astro.params.page);
const page = paginate(posts, pageNumber, site.postsPerPage);
---
<BaseLayout title={`全部文章 · 第 ${pageNumber} 页`} description={`全部已发布笔记第 ${pageNumber} 页，共 ${posts.length} 篇。`}>
	<header class="page-header"><p class="eyebrow">NOTES / ALL</p><h1>全部文章</h1><p class="description">按发布时间倒序排列。</p><div class="meta-line"><span>{posts.length} 篇已发布</span><span>·</span><span>第 {page.page} / {page.pageCount} 页</span></div></header>
	<CategoryNavigation />
	<section class="archive-list" aria-label={`文章第 ${pageNumber} 页`}>
		<PostList posts={page.items} />
		<Pagination page={page.page} pageCount={page.pageCount} />
	</section>
</BaseLayout>
<style>.archive-list { margin-top: 4px; }</style>
