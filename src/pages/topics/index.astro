---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topics } from '../../config/topics';
import { getPublishedPosts } from '../../lib/content';
const posts = await getPublishedPosts();
const topicData = topics.map((topic) => ({ ...topic, count: topic.posts.filter((id) => posts.some((post) => post.id === id)).length }));
---
<BaseLayout title="知识专题" description="跨越分类，以问题为线索重新组织笔记。">
	<header class="page-header"><p class="eyebrow">CURATED / SERIES</p><h1>知识专题</h1><p class="description">专题不是另一种分类，而是围绕一个问题重新编排的阅读路径。</p></header>
	<section class="topic-list" aria-label="全部专题">
		{topicData.map((topic, index) => <a href={`/topics/${topic.slug}/`}><span class="topic-number">{String(index + 1).padStart(2, '0')}</span><div><p class="topic-en">{topic.englishTitle}</p><h2>{topic.title}</h2><p class="topic-description">{topic.description}</p></div><span class="topic-count">{topic.count} 篇 <span aria-hidden="true">→</span></span></a>)}
	</section>
</BaseLayout>
<style>
	.topic-list { margin-top: 4px; border-top: 1px solid var(--line); }
	.topic-list > a { display: grid; grid-template-columns: 30px minmax(0, 1fr) auto; gap: 14px; align-items: center; min-height: 84px; padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
	.topic-list > a:hover h2 { color: var(--accent); }
	.topic-number { align-self: start; padding-top: 2px; color: var(--faint); font-family: var(--font-mono); font-size: 9.5px; }
	.topic-en { color: var(--faint); font-family: var(--font-mono); font-size: 8.5px; letter-spacing: .08em; }
	h2 { margin-top: 2px; font-size: 14px; }
	.topic-description { margin-top: 3px; color: var(--muted); font-size: 11.5px; }
	.topic-count { color: var(--faint); font-family: var(--font-mono); font-size: 9.5px; white-space: nowrap; }
	.topic-count span { margin-left: 3px; color: var(--muted); font-family: var(--font-sans); }
</style>
