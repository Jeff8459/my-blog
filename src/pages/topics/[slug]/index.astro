---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleRow from '../../../components/ArticleRow.astro';
import { topics } from '../../../config/topics';
import { getPublishedPosts } from '../../../lib/content';
export function getStaticPaths() { return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } })); }
const { topic } = Astro.props;
const allPosts = await getPublishedPosts();
const posts = topic.posts.map((id) => allPosts.find((post) => post.id === id)).filter((post) => post !== undefined);
---
<BaseLayout title={`专题：${topic.title}`} description={topic.description}>
	<header class="topic-hero shell"><p class="eyebrow">{topic.englishTitle}</p><span class="topic-series">CURATED SERIES · {String(posts.length).padStart(2, '0')} ARTICLES</span><h1>{topic.title}</h1><p>{topic.description}</p></header>
	<section class="shell topic-posts" aria-label={`${topic.title}专题文章`}>
		{posts.length ? posts.map((post, index) => <ArticleRow post={post} index={index} />) : <div class="empty-state"><h2>专题正在编辑中</h2><p>文章发布后，会按照专题配置显示在这里。</p></div>}
	</section>
	<div class="shell topic-back"><a class="text-link" href="/topics/">返回全部专题</a></div>
</BaseLayout>
<style>
	.topic-hero { padding-top: clamp(4rem, 8vw, 7rem); padding-bottom: clamp(3rem, 6vw, 5rem); border-bottom: 1px solid var(--text); text-align: center; }
	.topic-series { display: block; margin-top: 1rem; color: var(--muted); font-family: var(--font-serif); font-size: .65rem; letter-spacing: .14em; }
	h1 { margin-top: 2rem; font-size: clamp(2.8rem, 6vw, 5.5rem); font-weight: 550; }
	.topic-hero > p:last-child { max-width: 560px; margin: 1.5rem auto 0; color: var(--muted); line-height: 1.9; }
	.topic-posts { max-width: 1050px; }
	.topic-back { margin-top: 3rem; }
</style>
