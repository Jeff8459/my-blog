---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { topics } from '../../../config/topics';
import { getPublishedPosts } from '../../../lib/content';
export function getStaticPaths() { return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } })); }
const { topic } = Astro.props;
const allPosts = await getPublishedPosts();
const posts = topic.posts.map((id) => allPosts.find((post) => post.id === id)).filter((post) => post !== undefined);
---
<BaseLayout title={`专题：${topic.title}`} description={topic.description}>
	<header class="page-header"><p class="eyebrow">SERIES / {topic.englishTitle}</p><h1>{topic.title}</h1><p class="description">{topic.description}</p><div class="meta-line"><span>{posts.length} 篇笔记</span><span>·</span><a href="/topics/">全部专题</a></div></header>
	<section class="topic-posts" aria-label={`${topic.title}专题文章`}>
		<PostList posts={posts} emptyTitle="专题正在编辑中" emptyText="文章发布后，会按照专题配置显示在这里。" />
	</section>
</BaseLayout>
<style>.topic-posts { margin-top: 4px; } .meta-line a { color: var(--muted); text-decoration: none; } .meta-line a:hover { color: var(--accent); }</style>
