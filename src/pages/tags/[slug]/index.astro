---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleRow from '../../../components/ArticleRow.astro';
import { tags } from '../../../config/taxonomy';
import { getPostsByTag } from '../../../lib/content';
export function getStaticPaths() { return tags.map((tag) => ({ params: { slug: tag.slug }, props: { tag } })); }
const { tag } = Astro.props;
const posts = await getPostsByTag(tag.slug);
---
<BaseLayout title={`标签：${tag.name}`} description={`标签“${tag.name}”下的 ${posts.length} 篇文章。`}>
	<header class="page-hero shell"><div><p class="eyebrow">TAG / {tag.slug.toUpperCase()}</p><h1>#{tag.name}</h1></div><div><span class="page-count">{String(posts.length).padStart(2, '0')} ARTICLES</span><p>通过标签连接不同分类中的相关内容。</p></div></header>
	<section class="shell tag-posts" aria-label={`${tag.name}标签文章`}>
		{posts.length ? posts.map((post, index) => <ArticleRow post={post} index={index} />) : <div class="empty-state"><h2>这个标签还没有文章</h2><a href="/tags/">查看全部标签</a></div>}
	</section>
</BaseLayout>
<style>.tag-posts { padding-top: 2rem; }</style>
