---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { categories } from '../config/taxonomy';
import { topics } from '../config/topics';
import { getPublishedPosts } from '../lib/content';
const posts = await getPublishedPosts();
---
<BaseLayout title="关于本站" description={`关于${site.name}：知识空间的内容方向、组织方式与出版机制。`}>
	<header class="page-header"><p class="eyebrow">ABOUT / THIS GARDEN</p><h1>关于本站</h1><p class="description">一个持续生长的个人知识空间，收集技术、管理、阅读与日常思考中值得保留的部分。</p></header>
	<div class="about-layout">
		<div class="about-content">
			<section><h2>这是什么</h2><p>{site.author.bio}</p><p>这里不是按更新频率运转的内容流，而是一套可以反复修改、互相引用并逐渐建立联系的知识库。文章会更新，链接会生长，旧判断也可以在新的理解下被修订。</p></section>
			<section><h2>如何组织</h2><p>目前分为{categories.map((category) => category.name).join('、')}五个方向。分类提供长期结构，标签连接跨分类内容，专题则围绕具体问题组织阅读顺序。</p><p>笔记之间可以通过站内链接互相引用。被引用的文章会自动显示反向链接，帮助读者从一个想法走向相关上下文，而不是在文章末尾突然中断。</p></section>
			<section><h2>如何发布</h2><p>站点使用 Astro 构建为纯静态页面，内容保存在 Markdown 与 MDX 中。Pagefind 在构建后生成中文搜索索引。没有数据库、评论系统、外部统计脚本或需要长期运行的服务器。</p><p>带有「示例」标识的内容用于验证知识和排版功能，不代表作者的真实项目经历。</p></section>
			<section><h2>保持联系</h2><div class="about-links"><a class="button" href={site.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only">（新窗口打开）</span></a><a class="button" href="/rss.xml">RSS 订阅</a><a class="button" href="/search/">搜索知识库</a></div></section>
		</div>
		<aside class="about-meta" aria-label="站点信息">
			<div><span>名称</span><strong>{site.name}</strong></div>
			<div><span>标识</span><strong>{site.englishName}</strong></div>
			<div><span>笔记</span><strong>{posts.length}</strong></div>
			<div><span>分类</span><strong>{categories.length}</strong></div>
			<div><span>专题</span><strong>{topics.length}</strong></div>
			<div><span>技术</span><strong>Astro</strong></div>
			<div><span>搜索</span><strong>Pagefind</strong></div>
		</aside>
	</div>
</BaseLayout>
<style>
	.about-layout { display: grid; grid-template-columns: minmax(0, 1fr) 190px; gap: 48px; padding-top: 24px; }
	.about-content { max-width: 640px; }
	.about-content section { padding: 0 0 22px; }
	.about-content section + section { padding-top: 20px; border-top: 1px solid var(--line); }
	h2 { margin-bottom: 7px; font-size: 15px; }
	.about-content p { color: var(--muted); font-size: 13px; line-height: 1.8; }
	.about-content p + p { margin-top: 7px; }
	.about-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
	.about-meta { align-self: start; border-top: 1px solid var(--line); }
	.about-meta div { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 32px; border-bottom: 1px solid var(--line); }
	.about-meta span { color: var(--faint); font-size: 10.5px; }
	.about-meta strong { color: var(--muted); font-family: var(--font-mono); font-size: 10px; font-weight: 500; text-align: right; }
	@media (max-width: 760px) { .about-layout { grid-template-columns: 1fr; gap: 24px; } .about-meta { display: grid; grid-template-columns: 1fr 1fr; column-gap: 20px; } }
</style>
