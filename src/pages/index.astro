---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import HomeAside from '../components/HomeAside.astro';
import { site } from '../config/site';
import { categories } from '../config/taxonomy';
import { topics } from '../config/topics';
import { getPublishedPosts } from '../lib/content';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 6);
const updated = posts
	.filter((post) => post.data.updatedDate)
	.sort((a, b) => b.data.updatedDate!.valueOf() - a.data.updatedDate!.valueOf());
const topicData = topics
	.map((topic) => ({ ...topic, count: topic.posts.filter((id) => posts.some((post) => post.id === id)).length }))
	.filter((topic) => topic.count > 0);
const latestDate = posts[0]?.data.updatedDate ?? posts[0]?.data.pubDate;
---
<BaseLayout title={site.name} description={site.description}>
	<header class="home-header">
		<p class="eyebrow">DIGITAL GARDEN / {site.englishName}</p>
		<h1>{site.tagline}</h1>
		<p>{site.description}</p>
		<div class="home-stats">
			<span><strong>{posts.length}</strong> 篇笔记</span>
			<span><strong>{categories.filter((category) => posts.some((post) => post.data.category === category.slug)).length}</strong> 个活跃分类</span>
			{latestDate && <span>最近更新 <strong>{new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(latestDate).replaceAll('/', '.')}</strong></span>}
		</div>
	</header>

	<section class="section" aria-labelledby="recent-title">
		<div class="section-header"><h2 id="recent-title">最近更新</h2><a href="/blog/">全部文章 →</a></div>
		<PostList posts={recent} variant="compact" emptyTitle="知识库正在生长" emptyText="发布第一篇笔记后，这里会自动出现最近更新。" />
	</section>

	<section class="section" aria-labelledby="categories-title">
		<div class="section-header"><h2 id="categories-title">按分类浏览</h2><a href="/categories/">全部分类 →</a></div>
		<div class="category-index">
			{categories.map((category) => {
				const count = posts.filter((post) => post.data.category === category.slug).length;
				return <a href={`/categories/${category.slug}/`}><span class="category-name">{category.name}</span><span class="category-desc">{category.description}</span><span class="category-count">{count}</span></a>;
			})}
		</div>
	</section>

	{topicData.length > 0 && <section class="section" aria-labelledby="topics-title">
		<div class="section-header"><h2 id="topics-title">精选知识专题</h2><a href="/topics/">全部专题 →</a></div>
		<div class="topic-index">
			{topicData.map((topic, index) => <a href={`/topics/${topic.slug}/`}><span class="topic-mark">{String(index + 1).padStart(2, '0')}</span><div><strong>{topic.title}</strong><p>{topic.description}</p></div><span class="topic-count">{topic.count} 篇</span><span aria-hidden="true">→</span></a>)}
		</div>
	</section>}

	{updated.length > 0 && <section class="section" aria-labelledby="updated-title">
		<div class="section-header"><h2 id="updated-title">最近修改的笔记</h2></div>
		<PostList posts={updated.slice(0, 4)} variant="dense" showReadingTime={false} />
	</section>}

	<section class="section site-note" aria-labelledby="site-note-title">
		<div><p class="eyebrow">ABOUT</p><h2 id="site-note-title">一套持续生长的个人知识空间</h2><p>{site.author.bio}</p></div>
		<a class="text-link" href="/about/">关于本站 →</a>
	</section>
	{posts.some((post) => post.data.demo) && <p class="demo-note">当前含有明确标注的示例文章，用于验证知识库功能与排版。</p>}

	<div slot="aside"><HomeAside /></div>
</BaseLayout>
<style>
	.home-header { padding: 31px 0 23px; border-bottom: 1px solid var(--line); }
	.home-header h1 { max-width: 620px; margin-top: 7px; font-size: 30px; font-weight: 650; letter-spacing: -.03em; }
	.home-header > p:not(.eyebrow) { max-width: 620px; margin-top: 8px; color: var(--muted); font-size: 13px; line-height: 1.75; }
	.home-stats { display: flex; flex-wrap: wrap; align-items: center; gap: 0; margin-top: 14px; color: var(--faint); font-size: 10.5px; }
	.home-stats span + span::before { margin: 0 9px; color: var(--line-strong); content: '·'; }
	.home-stats strong { color: var(--muted); font-family: var(--font-mono); font-size: 10.5px; font-weight: 500; }
	.category-index { border-top: 1px solid var(--line); }
	.category-index a { display: grid; grid-template-columns: 92px minmax(0, 1fr) 28px; align-items: center; gap: 12px; min-height: 39px; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
	.category-index a:hover .category-name { color: var(--accent); }
	.category-name { font-size: 12.5px; font-weight: 550; }
	.category-desc { overflow: hidden; color: var(--muted); font-size: 11.5px; text-overflow: ellipsis; white-space: nowrap; }
	.category-count { color: var(--faint); font-family: var(--font-mono); font-size: 10px; text-align: right; }
	.topic-index { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
	.topic-index > a { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto auto; align-items: center; gap: 9px; min-height: 76px; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius); color: var(--text); text-decoration: none; }
	.topic-index > a:hover { border-color: var(--line-strong); background: var(--hover); }
	.topic-mark { color: var(--faint); font-family: var(--font-mono); font-size: 9.5px; }
	.topic-index strong { font-size: 12.5px; font-weight: 600; }
	.topic-index p { display: -webkit-box; margin-top: 2px; overflow: hidden; color: var(--muted); font-size: 10.5px; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.topic-count { color: var(--faint); font-family: var(--font-mono); font-size: 9.5px; white-space: nowrap; }
	.topic-index > a > span:last-child { color: var(--muted); font-size: 11px; }
	.site-note { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding: 14px 0; border-block: 1px solid var(--line); }
	.site-note h2 { margin-top: 3px; font-size: 14px; }
	.site-note div > p:last-child { max-width: 560px; margin-top: 5px; color: var(--muted); font-size: 11.5px; line-height: 1.7; }
	.site-note .text-link { flex: none; padding-bottom: 2px; }
	.demo-note { margin-top: 14px; color: var(--faint); font-size: 10.5px; }
	@media (max-width: 700px) {
		.home-header { padding-top: 23px; }
		.home-header h1 { font-size: 25px; }
		.home-stats span + span::before { margin: 0 6px; }
		.category-index a { grid-template-columns: 86px minmax(0, 1fr) 24px; gap: 8px; }
		.topic-index { grid-template-columns: 1fr; }
		.site-note { align-items: flex-start; flex-direction: column; gap: 8px; }
	}
</style>
