---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site } from '../config/site';
import { categories } from '../config/taxonomy';
import { topics } from '../config/topics';
import { getFeaturedPost, getPublishedPosts } from '../lib/content';

const posts = await getPublishedPosts();
const featured = await getFeaturedPost(posts);
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 3);
const topicData = topics.map((topic) => ({ ...topic, articles: topic.posts.map((id) => posts.find((post) => post.id === id)).filter(Boolean) })).filter((topic) => topic.articles.length > 0);
---
<BaseLayout title={site.name} description={site.description}>
	<section class="home-hero shell">
		<div class="hero-edition"><span>AN INDEPENDENT JOURNAL</span><span>VOL. 001 — {new Date().getFullYear()}</span></div>
		<div class="hero-main">
			<div>
				<p class="hero-name">{site.name}<span>{site.englishName}</span></p>
				<h1>记录思考，<br />积累认知<span>。</span></h1>
			</div>
			<div class="hero-intro"><span class="intro-line" aria-hidden="true"></span><p>{site.description}</p><a class="text-link" href="/about/">了解这个站点</a></div>
		</div>
	</section>

	{featured ? <section class="shell cover-section" aria-labelledby="cover-title">
		<h2 id="cover-title" class="sr-only">封面文章</h2>
		<FeaturedArticle post={featured} />
	</section> : <section class="shell cover-section"><div class="empty-state"><h2>第一篇文章，正在酝酿</h2><p>发布文章后，这里会自动出现封面与最新内容。</p></div></section>}

	{latest.length > 0 && <section class="section shell" aria-labelledby="latest-title">
		<div class="section-heading"><div><p class="eyebrow">LATEST STORIES</p><h2 id="latest-title">最新文章</h2></div><a href="/blog/">查看全部文章 →</a></div>
		<div class="latest-grid">{latest.map((post) => <ArticleCard post={post} />)}</div>
	</section>}

	<section class="section shell discovery" aria-labelledby="discovery-title">
		<h2 id="discovery-title" class="sr-only">分类与专题</h2>
		<div class="category-panel">
			<div class="panel-heading"><p class="eyebrow">SECTIONS</p><h3>按分类阅读</h3></div>
			<div class="category-list">{categories.map((category, index) => {
				const count = posts.filter((post) => post.data.category === category.slug).length;
				return <a href={`/categories/${category.slug}/`}><span class="category-number">{String(index + 1).padStart(2, '0')}</span><span>{category.name}</span><small>{count} 篇</small><span aria-hidden="true">↗</span></a>;
			})}</div>
		</div>
		<div class="topic-panel">
			<div class="panel-heading"><p class="eyebrow">CURATED SERIES</p><h3>编辑专题</h3></div>
			{topicData.map((topic, index) => <a class="topic-item" href={`/topics/${topic.slug}/`}><span class="topic-index">0{index + 1}</span><div><p>{topic.englishTitle}</p><h4>{topic.title}</h4><span>{topic.description}</span></div><span class="topic-arrow" aria-hidden="true">→</span></a>)}
			<a class="text-link all-topics" href="/topics/">全部专题</a>
		</div>
	</section>

	<section class="section shell author-section">
		<div class="author-symbol" aria-hidden="true">“</div>
		<div><p class="eyebrow">ABOUT THE AUTHOR</p><h2>保持好奇，<br />也保持审慎。</h2></div>
		<div class="author-copy"><p>{site.author.bio}</p><a class="text-link" href="/about/">关于作者与本站</a></div>
	</section>
	{posts.some((post) => post.data.demo) && <p class="shell demo-note">当前站点包含明确标注的示例文章，用于展示内容与排版能力。</p>}
</BaseLayout>
<style>
	.home-hero { padding-top: clamp(3rem, 7vw, 6rem); }
	.hero-edition { display: flex; justify-content: space-between; padding-bottom: 1.1rem; border-bottom: 1px solid var(--line); color: var(--muted); font-family: var(--font-serif); font-size: .63rem; letter-spacing: .15em; }
	.hero-main { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, .5fr); gap: 3rem; align-items: end; padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(3rem, 6vw, 5.5rem); }
	.hero-name { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.5rem; font-size: .8rem; font-weight: 600; letter-spacing: .12em; }
	.hero-name span { color: var(--muted); font-family: var(--font-serif); font-size: .62rem; font-weight: 400; letter-spacing: .16em; }
	h1 { font-size: clamp(3.3rem, 7.2vw, 6.6rem); font-weight: 550; line-height: 1.16; letter-spacing: -.075em; }
	h1 > span { color: var(--accent); }
	.hero-intro { padding-bottom: .7rem; }
	.intro-line { display: block; width: 2.5rem; height: 1px; margin-bottom: 1.5rem; background: var(--accent); }
	.hero-intro p { margin-bottom: 1.5rem; color: var(--muted); font-size: .92rem; line-height: 2; }
	.cover-section { padding-top: 1rem; }
	.latest-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.8rem); }
	.discovery { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(3rem, 7vw, 7rem); }
	.panel-heading { margin-bottom: 1.5rem; }
	.panel-heading h3 { margin-top: .4rem; font-size: 1.55rem; }
	.category-list { border-top: 1px solid var(--text); }
	.category-list a { display: grid; grid-template-columns: 2rem 1fr auto 1rem; align-items: center; gap: .8rem; min-height: 60px; border-bottom: 1px solid var(--line); color: var(--text); font-size: .88rem; text-decoration: none; }
	.category-list a:hover > span:nth-child(2) { color: var(--accent); }
	.category-number, .category-list small { color: var(--muted); font-family: var(--font-serif); font-size: .66rem; }
	.topic-item { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem; padding: 1.6rem 0; border-top: 1px solid var(--line); color: var(--text); text-decoration: none; }
	.topic-item:first-of-type { border-top-color: var(--text); }
	.topic-index { color: var(--accent); font-family: var(--font-serif); font-size: .72rem; }
	.topic-item p { color: var(--muted); font-family: var(--font-serif); font-size: .61rem; letter-spacing: .14em; }
	.topic-item h4 { margin: .35rem 0 .6rem; font-size: 1.35rem; }
	.topic-item div > span { color: var(--muted); font-size: .8rem; line-height: 1.8; }
	.topic-arrow { align-self: center; color: var(--accent); }
	.all-topics { margin-top: 1.5rem; }
	.author-section { display: grid; grid-template-columns: 80px minmax(0, 1fr) minmax(280px, .7fr); gap: 2rem; align-items: center; padding-bottom: var(--space-24); border-bottom: 1px solid var(--line); }
	.author-symbol { align-self: start; color: var(--accent); font-family: var(--font-serif); font-size: 6rem; line-height: 1; }
	.author-section h2 { margin-top: .8rem; font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 400; line-height: 1.4; }
	.author-copy p { margin-bottom: 1.5rem; color: var(--muted); font-size: .9rem; line-height: 2; }
	.demo-note { margin-top: 1.5rem; color: var(--muted); font-size: .68rem; }
	@media (max-width: 800px) { .hero-main { grid-template-columns: 1fr; gap: 2rem; } .hero-intro { max-width: 30rem; } .latest-grid { grid-template-columns: 1fr; gap: 3rem; } .discovery { grid-template-columns: 1fr; } .author-section { grid-template-columns: 40px 1fr; } .author-copy { grid-column: 2; } }
	@media (max-width: 480px) { h1 { font-size: clamp(3rem, 15vw, 4.2rem); } .hero-edition span:first-child { display: none; } .hero-edition { justify-content: flex-end; } .author-symbol { font-size: 4rem; } }
</style>
