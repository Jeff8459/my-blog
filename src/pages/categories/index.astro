---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../config/taxonomy';
import { getPublishedPosts } from '../../lib/content';
const posts = await getPublishedPosts();
---
<BaseLayout title="内容分类" description="按人工智能、技术实践、系统开发、管理思考和阅读随笔浏览知识库。">
	<header class="page-header"><p class="eyebrow">INDEX / SECTIONS</p><h1>内容分类</h1><p class="description">分类是长期稳定的内容入口。每个分类都根据真实已发布文章动态统计。</p></header>
	<section class="category-list" aria-label="全部分类">
		{categories.map((category, index) => {
			const categoryPosts = posts.filter((post) => post.data.category === category.slug);
			return <a href={`/categories/${category.slug}/`}><span class="index">{String(index + 1).padStart(2, '0')}</span><div><h2>{category.name}</h2><p>{category.description}</p></div><span class="count">{categoryPosts.length} 篇</span><span class="arrow" aria-hidden="true">→</span></a>;
		})}
	</section>
</BaseLayout>
<style>
	.category-list { margin-top: 4px; border-top: 1px solid var(--line); }
	.category-list > a { display: grid; grid-template-columns: 30px minmax(0, 1fr) auto 14px; align-items: center; gap: 14px; min-height: 68px; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
	.category-list > a:hover h2 { color: var(--accent); }
	.index { color: var(--faint); font-family: var(--font-mono); font-size: 9.5px; }
	h2 { font-size: 14px; }
	p { margin-top: 3px; color: var(--muted); font-size: 11.5px; }
	.count, .arrow { color: var(--faint); font-family: var(--font-mono); font-size: 10px; white-space: nowrap; }
	.arrow { font-family: var(--font-sans); }
	@media (max-width: 540px) { .category-list > a { grid-template-columns: 24px minmax(0, 1fr) auto; gap: 10px; padding: 10px 0; } .arrow { display: none; } }
</style>
