---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import CategoryNavigation from '../../../components/CategoryNavigation.astro';
import { categories } from '../../../config/taxonomy';
import { getPostsByCategory, getPublishedPosts } from '../../../lib/content';
export function getStaticPaths() { return categories.map((category) => ({ params: { slug: category.slug }, props: { category } })); }
const { category } = Astro.props;
const posts = await getPublishedPosts();
const categoryPosts = await getPostsByCategory(category.slug, posts);
---
<BaseLayout title={category.name} description={`${category.description}共 ${categoryPosts.length} 篇已发布笔记。`}>
	<header class="page-header"><p class="eyebrow">SECTION / {category.slug.toUpperCase()}</p><h1>{category.name}</h1><p class="description">{category.description}</p><div class="meta-line"><span>{categoryPosts.length} 篇笔记</span><span>·</span><a href="/categories/">全部分类</a></div></header>
	<CategoryNavigation />
	<section class="category-posts" aria-label={`${category.name}文章`}>
		<PostList posts={categoryPosts} emptyTitle="这个分类还没有笔记" emptyText="可以先浏览全部文章，或从左侧切换其他分类。" />
	</section>
</BaseLayout>
<style>.category-posts { margin-top: 4px; } .meta-line a { color: var(--muted); text-decoration: none; } .meta-line a:hover { color: var(--accent); }</style>
